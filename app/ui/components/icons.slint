// Line icons (24-unit grid, white strokes, tinted with `colorize`) and the PocketDeck logo.

export global Icons {
    out property <image> arrow-right: @image-url("../assets/icons/arrow-right.svg");
    out property <image> arrow-left: @image-url("../assets/icons/arrow-left.svg");
    out property <image> check: @image-url("../assets/icons/check.svg");
    out property <image> home: @image-url("../assets/icons/home.svg");
    out property <image> games: @image-url("../assets/icons/games.svg");
    out property <image> phone: @image-url("../assets/icons/phone.svg");
    out property <image> globe: @image-url("../assets/icons/globe.svg");
    out property <image> qr: @image-url("../assets/icons/qr.svg");
    out property <image> refresh: @image-url("../assets/icons/refresh.svg");
    out property <image> warning: @image-url("../assets/icons/warning.svg");
    out property <image> download: @image-url("../assets/icons/download.svg");
    out property <image> monitor: @image-url("../assets/icons/monitor.svg");
    out property <image> power: @image-url("../assets/icons/power.svg");
    out property <image> info: @image-url("../assets/icons/info.svg");
    out property <image> controller: @image-url("../assets/icons/controller.svg");
    out property <image> spinner: @image-url("../assets/icons/spinner.svg");
    out property <image> plug: @image-url("../assets/icons/plug.svg");
    out property <image> wrench: @image-url("../assets/icons/wrench.svg");
    out property <image> external: @image-url("../assets/icons/external.svg");
    out property <image> play: @image-url("../assets/icons/play.svg");
    out property <image> settings: @image-url("../assets/icons/settings.svg");
    out property <image> plus: @image-url("../assets/icons/plus.svg");
    out property <image> eye-off: @image-url("../assets/icons/eye-off.svg");
    out property <image> lock: @image-url("../assets/icons/lock.svg");

    // The mark without its background tile, like AppLogo on the phone.
    out property <image> logo: @image-url("../assets/logo-mark.svg");
}
