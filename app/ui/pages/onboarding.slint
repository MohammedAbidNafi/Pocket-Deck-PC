// First-run setup, mirroring the phone's OnboardingScreen.kt: same frame, step dots, page
// transitions and closing "setting up" hand-off.

import { Palette, Theme, DisplayText, PageTitle, HeadlineText, BodyText, LabelText } from "../theme.slint";
import { App, Engine, Sfx, Library } from "../state.slint";
import { ConsoleButton, IconBadge, IconPill, StepDots, ProgressBar } from "../components/widgets.slint";
import { LookControls, PreviewPanel } from "../components/look.slint";
import { EngineChecks } from "../components/engine.slint";
import { ConnectCard } from "library.slint";
import { SettingRow, RiseIn, Spinner, StatusRow, ProgressBar } from "../components/widgets.slint";
import { Icons } from "../components/icons.slint";

export global Setup {
    // Welcome, Look, Streaming engine, Your games. Pair your phone joins with remote play.
    out property <int> steps: 4;
}

// One page of setup. Fades and slides in from the side it comes from; fades out in place.
component Step inherits Rectangle {
    in property <int> index;
    property <bool> shown: App.onboarding-step == root.index;
    visible: self.opacity > 0.01;

    states [
        shown when root.shown: {
            opacity: 1;
            x: 0;
            in {
                animate opacity, x {
                    duration: 260ms;
                    easing: ease-out;
                }
            }
            out {
                animate opacity { duration: 140ms; }
                animate x {
                    delay: 140ms;
                    duration: 1ms;
                }
            }
        }
        hidden when !root.shown: {
            opacity: 0;
            x: App.onboarding-step > root.index ? -root.width / 8 : root.width / 8;
        }
    ]
}

// Logo that gently floats, with a soft breathing glow behind it.
component FloatingLogo inherits Rectangle {
    property <float> bob: sin(360deg * (animation-tick() / 4400ms));
    Rectangle {
        border-radius: self.width / 2;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.26 + 0.08 * root.bob) 0%, Theme.accent.with-alpha(0) 70%);
    }
    Image {
        y: root.bob * 6px;
        width: root.width;
        height: root.height;
        source: Icons.logo;
    }
}

component Feature inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        IconBadge {
            icon: root.icon;
        }
    }
    Text {
        text: root.text;
        font-size: 16px;
        color: Palette.text;
        vertical-alignment: center;
    }
}

component Welcome inherits Step {
    index: 0;
    HorizontalLayout {
        alignment: center;
        padding-left: Theme.screen-padding;
        padding-right: Theme.screen-padding;
        HorizontalLayout {
            max-width: 980px;
            spacing: 40px;
            VerticalLayout {
                alignment: center;
                FloatingLogo {
                    width: 210px;
                    height: 210px;
                }
            }
            VerticalLayout {
                alignment: center;
                LabelText {
                    text: "WELCOME TO";
                    font-size: 14px;
                    font-weight: 700;
                    letter-spacing: 0.4px;
                    color: Theme.accent;
                }
                DisplayText {
                    text: "PocketDeck";
                }
                BodyText {
                    text: "Your PC games, on your phone. Wherever you are.";
                }
                Rectangle {
                    height: 18px;
                }
                Feature {
                    icon: Icons.games;
                    text: "Your PC games, found and added for you";
                }
                Feature {
                    icon: Icons.globe;
                    text: "Play from anywhere, no router setup";
                }
                Feature {
                    icon: Icons.qr;
                    text: "Pair your phone with one scan";
                }
                Rectangle {
                    height: 20px;
                }
                HorizontalLayout {
                    alignment: start;
                    ConsoleButton {
                        text: "Get started";
                        icon: Icons.arrow-right;
                        primary: true;
                        clicked => {
                            App.onboarding-step = 1;
                            App.step-changed();
                        }
                    }
                }
            }
        }
    }
}

component Look inherits Step {
    index: 1;
    HorizontalLayout {
        padding-left: Theme.screen-padding;
        padding-right: Theme.screen-padding;
        padding-top: 52px;
        padding-bottom: 52px;
        spacing: 32px;
        VerticalLayout {
            horizontal-stretch: 1.15;
            alignment: center;
            HeadlineText {
                text: "Make it yours";
            }
            BodyText {
                font-size: 14px;
                text: "Changes apply right away. You can change them later in Settings.";
            }
            LookControls { }
        }
        PreviewPanel {
            horizontal-stretch: 1;
            ConsoleButton {
                text: "Continue";
                icon: Icons.arrow-right;
                primary: true;
                clicked => {
                    App.onboarding-step = 2;
                    App.step-changed();
                }
            }
        }
    }
}

component StreamingEngine inherits Step {
    index: 2;
    property <bool> all-good: Engine.status.installed && !Engine.status.outdated && Engine.status.running && Engine.status.answering && Engine.status.controller;

    HorizontalLayout {
        alignment: center;
        padding-left: Theme.screen-padding;
        padding-right: Theme.screen-padding;
        VerticalLayout {
            max-width: 760px;
            alignment: center;
            padding-top: 44px;
            padding-bottom: 56px;
            spacing: 0;
            PageTitle {
                text: "Get streaming ready";
            }
            Rectangle {
                height: 6px;
            }
            BodyText {
                text: Engine.own-sunshine ? "PocketDeck streams your games with Sunshine. Here's what it needs; anything missing can be fixed from here." : "PocketDeck streams your games with its own streaming engine. Here's what it needs; anything missing can be fixed from here.";
            }
            Rectangle {
                height: 22px;
            }
            EngineChecks { }
            Rectangle {
                height: 22px;
            }
            HorizontalLayout {
                spacing: 16px;
                ConsoleButton {
                    text: "Check again";
                    icon: Icons.refresh;
                    enabled: !Engine.task.active;
                    clicked => {
                        Engine.refresh();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                ConsoleButton {
                    text: root.all-good || !Engine.status.checked ? "Continue" : "Continue anyway";
                    icon: Icons.arrow-right;
                    primary: true;
                    enabled: !Engine.task.active;
                    clicked => {
                        App.onboarding-step = 3;
                        App.step-changed();
                        Library.refresh();
                    }
                }
            }
        }
    }
}


component GamesStep inherits Step {
    index: 3;
    property <int> total: Library.on-phone;

    HorizontalLayout {
        alignment: center;
        padding-left: Theme.screen-padding;
        padding-right: Theme.screen-padding;
        VerticalLayout {
            max-width: 760px;
            alignment: center;
            padding-top: 44px;
            padding-bottom: 56px;
            spacing: 0;
            PageTitle {
                text: "Your games";
            }
            Rectangle {
                height: 6px;
            }
            BodyText {
                text: "PocketDeck found these on your PC. Their games go to your phone's library on their own, and new ones join as you install them.";
            }
            Rectangle {
                height: 22px;
            }
            VerticalLayout {
                spacing: 10px;
                for src[i] in Library.sources: RiseIn {
                    delay: i * 70ms;
                    SettingRow {
                        title: src.label;
                        subtitle: !src.found ? "Not installed on this PC." : src.count == 0 ? "No games installed yet." : src.count == 1 ? "1 game found" : "\{src.count} games found";
                        icon: Icons.games;
                        has-toggle: true;
                        toggle-on: src.on && src.found;
                        enabled: src.found;
                        clicked => {
                            Library.toggle-source(src.id);
                        }
                    }
                }
            }
            if Library.access == "needs-login": VerticalLayout {
                padding-top: 16px;
                ConnectCard { }
            }
            // Once connected, say so (the connect card doesn't just vanish).
            if Library.access == "ok": VerticalLayout {
                padding-top: 16px;
                RiseIn {
                    StatusRow {
                        state: 1;
                        title: Engine.own-sunshine ? "Connected to Sunshine" : "Connected";
                        subtitle: Library.busy ? Library.message : "Games switched on here go to your phone, and new ones join as you install them.";
                    }
                }
            }
            if Library.busy: VerticalLayout {
                padding-top: 12px;
                ProgressBar {
                    value: Library.progress;
                }
            }
            Rectangle {
                height: 22px;
            }
            HorizontalLayout {
                spacing: 12px;
                if Library.busy: VerticalLayout {
                    alignment: center;
                    Spinner {
                        width: 18px;
                        height: 18px;
                    }
                }
                BodyText {
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-size: 14px;
                    text: Library.message;
                }
                ConsoleButton {
                    text: Library.access == "needs-login" ? "Skip for now" : "Continue";
                    icon: Icons.arrow-right;
                    primary: Library.access != "needs-login";
                    clicked => {
                        App.finishing = true;
                    }
                }
            }
        }
    }
}

// The closing hand-off: progress, then the logo rushes at the screen in a flood of light.
component SettingUp inherits Rectangle {
    background: Palette.background;

    property <duration> start;
    property <duration> elapsed: animation-tick() - root.start;
    property <float> progress: root.elapsed < 1500ms ? 0.85 * (1 - pow(1 - root.elapsed / 1500ms, 3)) : min(1, 0.85 + 0.15 * (root.elapsed - 1500ms) / 300ms);
    property <int> line: root.elapsed < 1800ms ? min(2, floor(root.elapsed / 700ms)) : 3;
    property <[string]> lines: ["Finding your games…", "Getting the artwork ready…", "Almost there…", "Ready!"];
    property <float> w-lin: clamp((root.elapsed - 2250ms) / 820ms, 0, 1);
    property <float> warp: root.w-lin * root.w-lin * root.w-lin;
    property <float> pulse: 1 + 0.04 * sin(360deg * (animation-tick() / 1400ms));

    init => {
        root.start = animation-tick();
    }

    // The big moment: the startup sound as the logo rushes at the screen, as on the phone.
    Timer {
        interval: 2250ms;
        triggered => {
            self.running = false;
            Sfx.play("intro");
        }
    }

    Timer {
        interval: 3100ms;
        triggered => {
            self.running = false;
            App.finish-onboarding();
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 170px;
                height: 170px;
                transform-scale: 1 + root.warp * root.warp * 9;
                transform-rotation: 25deg * root.warp;
                Rectangle {
                    border-radius: self.width / 2;
                    background: @radial-gradient(circle, Theme.accent.with-alpha(0.25) 0%, Theme.accent.with-alpha(0) 70%);
                }
                Image {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    source: Icons.spinner;
                    colorize: Theme.accent;
                    transform-rotation: 1deg * mod(root.elapsed / 1ms * (1 + root.warp * 3), 1100) * 360 / 1100;
                }
                Image {
                    width: 118px;
                    height: 118px;
                    source: Icons.logo;
                    transform-scale: root.pulse;
                }
            }
        }
        VerticalLayout {
            opacity: clamp(1 - root.warp * 3, 0, 1);
            alignment: center;
            spacing: 0;
            Rectangle {
                height: 22px;
            }
            Text {
                text: "Setting up your dashboard";
                font-size: 24px;
                font-weight: 700;
                color: Palette.text;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 6px;
            }
            Text {
                text: root.lines[root.line];
                font-size: 16px;
                font-weight: root.line == 3 ? 700 : 400;
                color: root.line == 3 ? Theme.accent : Palette.text-dim;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 18px;
            }
            HorizontalLayout {
                alignment: center;
                ProgressBar {
                    width: 260px;
                    value: root.progress;
                }
            }
        }
    }

    // Flood of light bursting out of the logo, ending in a bright accent glow.
    property <length> burst: sqrt(root.width * root.width / 1px / 1px + root.height * root.height / 1px / 1px) * 1px * 1.5 * root.warp;
    if root.warp > 0: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.burst;
        height: root.burst;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, #ffffff.with-alpha(0.95 * root.warp) 0%, Theme.accent.with-alpha(0.9 * root.warp) 35%, Theme.accent.with-alpha(0) 70%);
    }
}

export component Onboarding inherits Rectangle {
    background: @radial-gradient(circle, Theme.accent.with-alpha(0.22) 0%, Theme.accent.with-alpha(0.08) 55%, Palette.background 100%);
    Welcome { }
    Look { }
    StreamingEngine { }
    GamesStep { }

    StepDots {
        y: 18px;
        height: 8px;
        count: Setup.steps;
        current: App.onboarding-step;
    }

    // Back to the previous step.
    if App.onboarding-step > 0 && !App.finishing: Rectangle {
        x: 24px;
        y: 12px;
        width: 40px;
        height: 40px;
        IconPill {
            icon: Icons.arrow-left;
            label: "Back";
            click-sound: "back";
            clicked => {
                App.onboarding-step -= 1;
                App.step-changed();
            }
        }
    }

    if App.finishing: SettingUp { }
}
